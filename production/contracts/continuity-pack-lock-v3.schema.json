{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/continuity-pack-lock-v3.schema.json",
  "title": "PunchGrow immutable continuity pack lock v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolAuthoritySha256", "packId", "manifest", "reviewCoverage", "finalization", "sourceTreeSha256", "entryCount", "outputSha256", "publicSignature"],
  "properties": {
    "schemaVersion": { "const": "continuity-pack-lock-v3" },
    "protocolAuthoritySha256": { "const": "e1a569f6cd3351c04db5795acc98762d6f2bfd0596826fc4a0c35fe3f870df5e" },
    "packId": { "const": "biological-continuity-v3" },
    "manifest": { "$ref": "#/$defs/file" }, "reviewCoverage": { "$ref": "#/$defs/file" },
    "finalization": {
      "type": "object", "additionalProperties": false,
      "required": ["statePath", "stateSha256", "acceptedTipSetSha256", "acceptedTipCount", "terminalStatePath"],
      "properties": {
        "statePath": { "const": "production/reports/biological-continuity-v3/g003-evidence-v3/finalization/finalizing.json" },
        "stateSha256": { "$ref": "#/$defs/sha256" },
        "acceptedTipSetSha256": { "$ref": "#/$defs/sha256" },
        "acceptedTipCount": { "const": 367 },
        "terminalStatePath": { "const": "production/reports/biological-continuity-v3/g003-evidence-v3/finalization/terminal.json" }
      }
    },
    "sourceTreeSha256": { "$ref": "#/$defs/sha256" }, "entryCount": { "const": 240 }, "outputSha256": { "$ref": "#/$defs/sha256" },
    "publicSignature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityEpoch", "authorityFingerprint", "purpose", "schemaSha256", "signatureBase64"],
      "properties": { "algorithm": { "const": "Ed25519" }, "authorityEpoch": { "const": "g003-authority-epoch-v1" }, "authorityFingerprint": { "const": "91336f3180f8cf86cdef4b35f271c1e64eb609cd6b4e7f53360c777fa1a48e54" }, "purpose": { "const": "g003:pack-lock" }, "schemaSha256": { "const": "14438ff760324d5909fa9f2aa2680c53edccb06d148e4f18421f60db237fb01e" }, "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
