{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://punchgrow.local/contracts/g003-rejection-tombstone-supersession-v1.schema.json",
  "title": "Append-only rejection tombstone invalidation v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "supersessionId", "tombstoneKey", "priorTombstoneSha256", "priorTombstoneFileSha256", "action", "reasonCode", "invalidityProofSha256", "quarantineAssignmentRawSha256s", "quarantineAttestationRawSha256s", "priorSupersessionSha256", "issuedAt", "outputSha256", "publicSignature"],
  "properties": { "schemaVersion": { "const": "continuity-g003-rejection-tombstone-supersession-v1" }, "supersessionId": { "$ref": "#/$defs/sha" }, "tombstoneKey": { "$ref": "#/$defs/sha" }, "priorTombstoneSha256": { "$ref": "#/$defs/sha" }, "priorTombstoneFileSha256": { "$ref": "#/$defs/sha" }, "action": { "const": "INVALIDATE_REJECTION" }, "reasonCode": { "type": "string", "minLength": 3 }, "invalidityProofSha256": { "$ref": "#/$defs/sha" }, "quarantineAssignmentRawSha256s": { "$ref": "#/$defs/pair" }, "quarantineAttestationRawSha256s": { "$ref": "#/$defs/pair" }, "priorSupersessionSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "issuedAt": { "type": "string", "format": "date-time" }, "outputSha256": { "$ref": "#/$defs/sha" }, "publicSignature": { "$ref": "#/$defs/signature" } },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pair": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } }, "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityEpoch", "authorityFingerprint", "delegationOutputSha256", "purpose", "schemaSha256", "signatureBase64"], "properties": { "algorithm": { "const": "Ed25519" }, "authorityEpoch": { "const": "continuity-authority-epoch-v1" }, "authorityFingerprint": { "$ref": "#/$defs/sha" }, "delegationOutputSha256": { "$ref": "#/$defs/sha" }, "purpose": { "const": "continuity:g003-rejection-tombstone-supersession-v1" }, "schemaSha256": { "$ref": "#/$defs/sha" }, "signatureBase64": { "type": "string", "minLength": 88, "maxLength": 88 } } } }
}
