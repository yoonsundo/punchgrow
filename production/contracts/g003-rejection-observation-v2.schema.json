{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/g003-rejection-observation-v2.schema.json",
  "title": "Exact reviewer-authored G003 rejection observation v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assignmentId", "assignmentRawSha256", "reviewerInstanceId", "agentTaskId", "voterReviewRunId", "passNumber", "opaqueCandidateId", "generationRunId", "packageManifestSha256", "materialBindingSha256", "inputAllowlistSha256", "promptSha256", "inputAssetSha256s", "requiredChildTaxonomy", "verdict", "passEvidence", "failureFindings", "explanation", "confidence", "observedAt"],
  "properties": {
    "schemaVersion": { "const": "continuity-g003-rejection-observation-v2" },
    "assignmentId": { "type": "string", "minLength": 16 }, "assignmentRawSha256": { "$ref": "#/$defs/sha" },
    "reviewerInstanceId": { "type": "string", "minLength": 8 }, "agentTaskId": { "type": "string", "minLength": 8 }, "voterReviewRunId": { "type": "string", "minLength": 8 }, "passNumber": { "enum": [1, 2] },
    "opaqueCandidateId": { "type": "string", "pattern": "^candidate-[a-f0-9]{24}$" }, "generationRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "packageManifestSha256": { "$ref": "#/$defs/sha" }, "materialBindingSha256": { "$ref": "#/$defs/sha" }, "inputAllowlistSha256": { "$ref": "#/$defs/sha" }, "promptSha256": { "$ref": "#/$defs/sha" },
    "inputAssetSha256s": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } },
    "requiredChildTaxonomy": { "$ref": "#/$defs/taxonomy" }, "verdict": { "const": "REJECT" }, "passEvidence": { "type": "null" },
    "failureFindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
    "explanation": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "observedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taxonomy": { "type": "object", "additionalProperties": false, "required": ["biologicalClass", "speciesFamily", "coreAnatomy", "locomotionPlan"], "properties": { "biologicalClass": { "type": "string", "minLength": 1 }, "speciesFamily": { "type": "string", "minLength": 1 }, "coreAnatomy": { "type": "string", "minLength": 1 }, "locomotionPlan": { "type": "string", "minLength": 1 } } },
    "surfaces": { "const": ["master", "runtime"] }, "text": { "type": "string", "minLength": 1 },
    "finding": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "field", "expected", "observed", "surfaces", "explanation"], "properties": { "type": { "const": "taxonomy-mismatch" }, "field": { "enum": ["biologicalClass", "speciesFamily", "coreAnatomy", "locomotionPlan"] }, "expected": { "$ref": "#/$defs/text" }, "observed": { "$ref": "#/$defs/text" }, "surfaces": { "$ref": "#/$defs/surfaces" }, "explanation": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "parentRole", "expected", "observed", "surfaces", "explanation"], "properties": { "type": { "const": "same-creature-failure" }, "parentRole": { "pattern": "^parent-[12]$" }, "expected": { "const": "yes" }, "observed": { "const": "no" }, "surfaces": { "$ref": "#/$defs/surfaces" }, "explanation": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "parentRole", "anchorId", "expected", "observed", "surfaces", "explanation"], "properties": { "type": { "const": "anchor-failure" }, "parentRole": { "pattern": "^parent-[12]$" }, "anchorId": { "$ref": "#/$defs/text" }, "expected": { "$ref": "#/$defs/text" }, "observed": { "$ref": "#/$defs/text" }, "surfaces": { "$ref": "#/$defs/surfaces" }, "explanation": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "benchmarkId", "metric", "expectedMinimum", "observed", "explanation"], "properties": { "type": { "const": "eilu-failure" }, "benchmarkId": { "const": "eilu-comparative-visual-v1" }, "metric": { "enum": ["continuityScore", "anchorRetentionRatio", "retainedAnchorCount"] }, "expectedMinimum": { "type": "number" }, "observed": { "type": "number" }, "explanation": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "surface", "field", "expected", "observed", "explanation"], "properties": { "type": { "const": "canonical-surface-failure" }, "surface": { "enum": ["master", "runtime"] }, "field": { "$ref": "#/$defs/text" }, "expected": { "$ref": "#/$defs/text" }, "observed": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "surface", "expectedAmbiguity", "observedAmbiguity", "explanation"], "properties": { "type": { "const": "appendage-ambiguity" }, "surface": { "enum": ["master", "runtime"] }, "expectedAmbiguity": { "const": false }, "observedAmbiguity": { "const": true }, "explanation": { "$ref": "#/$defs/text" } } }
    ] }
  }
}
