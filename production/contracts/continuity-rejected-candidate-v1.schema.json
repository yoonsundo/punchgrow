{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/continuity-rejected-candidate-v1.schema.json",
  "title": "PunchGrow immutable rejected continuity candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "generationRunId", "archiveId", "archiveBinding", "materialSha256s", "reasonCodes", "sourceFiles", "associatedReviewSha256s", "rejectedAt", "nonce", "outputSha256", "conductorHmacSha256", "publicSignature"],
  "properties": {
    "schemaVersion": { "const": "continuity-rejected-candidate-v1" },
    "candidateId": { "type": "string", "pattern": "^(g003-candidate:PG-[0-9]{3}|g003-edge:PG-[0-9]{3}:PG-[0-9]{3})$" },
    "generationRunId": { "$ref": "#/$defs/generationRunId" },
    "archiveId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "archiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "generationRunId", "materialSha256s", "reasonCodes", "sourceFiles", "associatedReviewSha256s", "rejectedAt", "nonce"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^(g003-candidate:PG-[0-9]{3}|g003-edge:PG-[0-9]{3}:PG-[0-9]{3})$" },
        "generationRunId": { "$ref": "#/$defs/generationRunId" },
        "materialSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" } },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "associatedReviewSha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "minLength": 16 }
      }
    },
    "materialSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" } },
    "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "associatedReviewSha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "rejectedAt": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 16 },
    "outputSha256": { "$ref": "#/$defs/sha256" }, "conductorHmacSha256": { "$ref": "#/$defs/sha256" },
    "publicSignature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityFingerprint", "signatureBase64"], "properties": { "algorithm": { "const": "Ed25519" }, "authorityFingerprint": { "$ref": "#/$defs/sha256" }, "signatureBase64": { "type": "string", "minLength": 80 } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
