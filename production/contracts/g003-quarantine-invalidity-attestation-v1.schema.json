{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://punchgrow.local/contracts/g003-quarantine-invalidity-attestation-v1.schema.json",
  "title": "Reviewer-authored zero-credit quarantine invalidity attestation v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assignmentId", "assignmentRawSha256", "reviewerInstanceId", "agentTaskId", "reviewRunId", "passNumber", "materialKey", "materialSha256s", "archivedMaterialFileSha256s", "lockedContractSha256", "priorRejectionObservationSha256", "tombstoneOutputSha256", "tombstoneFileSha256", "verdict", "obligationCredit", "pixelDisposition", "invalidityFinding", "confidence", "observedAt", "outputSha256", "publicSignature"],
  "properties": { "schemaVersion": { "const": "continuity-g003-quarantine-invalidity-attestation-v1" }, "assignmentId": { "type": "string", "minLength": 8 }, "assignmentRawSha256": { "$ref": "#/$defs/sha" }, "reviewerInstanceId": { "type": "string", "minLength": 8 }, "agentTaskId": { "type": "string", "minLength": 8 }, "reviewRunId": { "type": "string", "minLength": 8 }, "passNumber": { "enum": [1, 2] }, "materialKey": { "$ref": "#/$defs/sha" }, "materialSha256s": { "$ref": "#/$defs/pair" }, "archivedMaterialFileSha256s": { "$ref": "#/$defs/pair" }, "lockedContractSha256": { "$ref": "#/$defs/sha" }, "priorRejectionObservationSha256": { "$ref": "#/$defs/sha" }, "tombstoneOutputSha256": { "$ref": "#/$defs/sha" }, "tombstoneFileSha256": { "$ref": "#/$defs/sha" }, "verdict": { "const": "INVALID_REJECTION" }, "obligationCredit": { "const": 0 }, "pixelDisposition": { "const": "UNCHANGED" }, "invalidityFinding": { "type": "object", "additionalProperties": false, "required": ["type", "expected", "observed", "evidenceSha256", "explanation"], "properties": { "type": { "enum": ["taxonomy-claim-mismatch", "contract-binding-mismatch", "observation-material-mismatch", "tombstone-binding-mismatch"] }, "expected": { "type": "string", "minLength": 1 }, "observed": { "type": "string", "minLength": 1 }, "evidenceSha256": { "$ref": "#/$defs/sha" }, "explanation": { "type": "string", "minLength": 1 } } }, "confidence": { "type": "number", "minimum": 0.96, "maximum": 1 }, "observedAt": { "type": "string", "format": "date-time" }, "outputSha256": { "$ref": "#/$defs/sha" }, "publicSignature": { "$ref": "#/$defs/signature" } },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pair": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } }, "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityEpoch", "authorityFingerprint", "delegationOutputSha256", "purpose", "schemaSha256", "signatureBase64"], "properties": { "algorithm": { "const": "Ed25519" }, "authorityEpoch": { "const": "continuity-authority-epoch-v1" }, "authorityFingerprint": { "$ref": "#/$defs/sha" }, "delegationOutputSha256": { "$ref": "#/$defs/sha" }, "purpose": { "const": "continuity:g003-quarantine-invalidity-attestation-v1" }, "schemaSha256": { "$ref": "#/$defs/sha" }, "signatureBase64": { "type": "string", "minLength": 88, "maxLength": 88 } } } }
}
