{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/g003-review-coverage-v1.schema.json",
  "title": "G003 global visual review coverage gate v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "state", "completionAllowed", "eiluBenchmark", "queueCandidates", "edgeCandidates", "coverage"],
  "properties": {
    "schemaVersion": { "const": "continuity-g003-review-gate-v1" },
    "state": { "enum": ["PENDING_G003_REVIEW", "PASS"] },
    "completionAllowed": { "type": "boolean" },
    "eiluBenchmark": { "$ref": "#/$defs/eiluBenchmark" },
    "queueCandidates": { "type": "array", "minItems": 175, "maxItems": 175, "items": { "$ref": "#/$defs/queueCandidate" } },
    "edgeCandidates": { "type": "array", "minItems": 190, "maxItems": 190, "items": { "$ref": "#/$defs/edgeCandidate" } },
    "coverage": { "$ref": "#/$defs/coverage" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pgId": { "type": "string", "pattern": "^PG-[0-9]{3}$" },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorKey", "parentRole", "parentId", "anchorId", "description", "sourceReviewId", "sourceConfidence", "resolutionState", "dependencyCandidateId"],
      "properties": {
        "anchorKey": { "type": "string", "pattern": "^PG-[0-9]{3}:.+" },
        "parentRole": { "type": ["string", "null"], "pattern": "^parent-[12]$" },
        "parentId": { "anyOf": [{ "$ref": "#/$defs/pgId" }, { "type": "null" }] },
        "anchorId": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"], "minLength": 3 },
        "sourceReviewId": { "type": ["string", "null"], "minLength": 8 },
        "sourceConfidence": { "type": ["number", "null"], "minimum": 0.85, "maximum": 1 },
        "resolutionState": { "enum": ["RESOLVED_AUTHENTICATED_PIXELS", "RESOLVED_SIGNED_CANONICAL_REDESIGN_TARGET", "PENDING_APPROVED_PARENT_REVIEW"] },
        "dependencyCandidateId": { "type": ["string", "null"], "pattern": "^g003-candidate:PG-[0-9]{3}$" }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumConfidence", "minimumAnchorRetentionRatio", "sameCreatureGrownUp"],
      "properties": { "minimumConfidence": { "const": 0.96 }, "minimumAnchorRetentionRatio": { "const": 1 }, "sameCreatureGrownUp": { "const": "yes" } }
    },
    "eiluBenchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmarkId", "assetIds", "minimumConfidence", "minimumRetainedAnchorCount", "minimumAnchorRetentionRatio", "comparisonRequirements", "pixelBindings"],
      "properties": {
        "benchmarkId": { "const": "eilu-comparative-visual-v1" }, "assetIds": { "const": ["PG-001", "PG-061", "PG-181"] },
        "minimumConfidence": { "const": 0.96 }, "minimumRetainedAnchorCount": { "const": 3 }, "minimumAnchorRetentionRatio": { "const": 1 },
        "comparisonRequirements": { "const": { "sameCreatureGrownUp": "yes", "compareAgainstBenchmark": true, "candidateConfidenceAtLeastBenchmark": true } },
        "pixelBindings": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["pgId", "masterSha256", "runtimeSha256"], "properties": { "pgId": { "$ref": "#/$defs/pgId" }, "masterSha256": { "$ref": "#/$defs/sha256" }, "runtimeSha256": { "$ref": "#/$defs/sha256" } } } }
      }
    },
    "eiluEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmarkId", "passed", "inputAssetSha256s", "perStageScores", "minimumScore"],
      "properties": {
        "benchmarkId": { "const": "eilu-comparative-visual-v1" }, "passed": { "const": true },
        "inputAssetSha256s": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "perStageScores": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0.96, "maximum": 1 } },
        "minimumScore": { "type": "number", "minimum": 0.96, "maximum": 1 }
      }
    },
    "baseEvidence": {
      "type": "object",
      "required": ["candidateId", "reviewArtifactPath", "reviewArtifactSha256", "packageManifestSha256", "materialBindingSha256", "inputAllowlistSha256", "promptSha256", "reviewPolicy", "parentEvidence", "approvedChildPixelSha256s", "sourceReviewIds", "sourceReviewOutputSha256s", "sourceReviewSignatureSha256s", "eiluEvidence"],
      "properties": {
        "candidateId": { "pattern": "^g003-candidate:PG-[0-9]{3}$" },
        "reviewArtifactPath": { "type": "string", "pattern": "^production/reports/biological-continuity-v3/g003-evidence-v1/.+\\.json$" },
        "reviewArtifactSha256": { "$ref": "#/$defs/sha256" },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" }, "materialBindingSha256": { "$ref": "#/$defs/sha256" },
        "inputAllowlistSha256": { "$ref": "#/$defs/sha256" }, "promptSha256": { "$ref": "#/$defs/sha256" },
        "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" },
        "parentEvidence": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/parentEvidence" } },
        "approvedChildPixelSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "sourceReviewIds": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
        "sourceReviewOutputSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "sourceReviewSignatureSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "eiluEvidence": { "$ref": "#/$defs/eiluEvidence" }
      }
    },
    "taxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["biologicalClass", "speciesFamily", "coreAnatomy", "locomotionPlan"],
      "properties": { "biologicalClass": { "type": "string", "minLength": 1 }, "speciesFamily": { "type": "string", "minLength": 1 }, "coreAnatomy": { "type": "string", "minLength": 1 }, "locomotionPlan": { "type": "string", "minLength": 1 } }
    },
    "reviewPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["assessmentMode", "continuitySubject", "taxonomyTargetSource", "requiredChildTaxonomy", "canonicalContractOutputSha256", "historicalParentPixelsOnly", "visibilityPolicy", "clarificationRequirements"],
      "properties": {
        "assessmentMode": { "enum": ["same-creature-continuity", "canonical-root-replacement"] }, "continuitySubject": { "enum": ["prior-parent-pixels", "signed-canonical-root-contract"] },
        "taxonomyTargetSource": { "type": "string", "minLength": 1 }, "requiredChildTaxonomy": { "$ref": "#/$defs/taxonomy" },
        "canonicalContractOutputSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "historicalParentPixelsOnly": { "type": "boolean" },
        "visibilityPolicy": { "anyOf": [{ "$ref": "#/$defs/visibilityPolicy" }, { "type": "null" }] },
        "clarificationRequirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 8 } }
      }
    },
    "visibilityPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaceRequirement", "appendageCountingRule", "ambiguityRule", "preservationRule"],
      "properties": {
        "surfaceRequirement": { "const": "master-and-runtime-independently-satisfy-canonical-tuple-and-all-three-anchors" },
        "appendageCountingRule": { "const": "count-visible-appendages-only" },
        "ambiguityRule": { "const": "hidden-merged-or-double-readable-is-block" },
        "preservationRule": { "const": "preserve-anchor-shape-relative-placement-and-color-role" }
      }
    },
    "parentEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceRole", "parentRole", "parentId", "parentPixelSha256s", "approvedParentCandidateId", "approvedParentReviewSha256", "anchors"],
      "properties": {
        "evidenceRole": { "enum": ["continuity-parent", "historical-reference-only"] },
        "parentRole": { "pattern": "^parent-[12]$" }, "parentId": { "$ref": "#/$defs/pgId" },
        "parentPixelSha256s": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "approvedParentCandidateId": { "type": ["string", "null"], "pattern": "^g003-candidate:PG-[0-9]{3}$" },
        "approvedParentReviewSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }
      }
    },
    "queueCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "slotId", "status", "allowedAnchorIds", "allowedAnchors", "requiredParentCandidateIds", "eiluBenchmarkId", "comparisonThresholds", "reviewEvidence"],
      "properties": {
        "candidateId": { "pattern": "^g003-candidate:PG-[0-9]{3}$" }, "slotId": { "$ref": "#/$defs/pgId" },
        "status": { "enum": ["PENDING_COMPARATIVE_VISUAL_REVIEW", "PASS"] },
        "allowedAnchorIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowedAnchors": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/anchor" } },
        "requiredParentCandidateIds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "pattern": "^g003-candidate:PG-[0-9]{3}$" } },
        "eiluBenchmarkId": { "const": "eilu-comparative-visual-v1" }, "comparisonThresholds": { "$ref": "#/$defs/thresholds" },
        "reviewEvidence": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/baseEvidence" }] }
      }
    },
    "parentAnchorIds": { "type": "object", "additionalProperties": false, "required": ["parentRole", "parentId", "anchorIds"], "properties": { "parentRole": { "pattern": "^parent-[12]$" }, "parentId": { "$ref": "#/$defs/pgId" }, "anchorIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "parentAnchors": {
      "type": "object", "additionalProperties": false,
      "required": ["parentRole", "parentId", "sourceKind", "approvedParentCandidateId", "approvedParentReviewSha256", "parentPixelSha256s", "anchors"],
      "properties": {
        "parentRole": { "pattern": "^parent-[12]$" }, "parentId": { "$ref": "#/$defs/pgId" }, "sourceKind": { "enum": ["generated-parent-candidate", "retained-parent-pixels"] },
        "approvedParentCandidateId": { "type": ["string", "null"], "pattern": "^g003-candidate:PG-[0-9]{3}$" }, "approvedParentReviewSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "parentPixelSha256s": { "anyOf": [{ "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, { "type": "null" }] },
        "anchors": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/anchor" } }
      }
    },
    "edgeEvidence": { "allOf": [{ "$ref": "#/$defs/baseEvidence" }, { "type": "object", "required": ["edgeId", "parentEvidence"], "properties": { "edgeId": { "pattern": "^g003-edge:PG-[0-9]{3}:PG-[0-9]{3}$" }, "parentEvidence": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/parentEvidence" } } } }] },
    "edgeCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["edgeId", "parentId", "childId", "status", "allowedParentAnchorIds", "allowedParentAnchors", "eiluBenchmarkId", "comparisonThresholds", "reviewEvidence"],
      "properties": {
        "edgeId": { "pattern": "^g003-edge:PG-[0-9]{3}:PG-[0-9]{3}$" }, "parentId": { "$ref": "#/$defs/pgId" }, "childId": { "$ref": "#/$defs/pgId" }, "status": { "enum": ["PENDING_COMPARATIVE_VISUAL_REVIEW", "PASS"] },
        "allowedParentAnchorIds": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/parentAnchorIds" } },
        "allowedParentAnchors": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/parentAnchors" } },
        "eiluBenchmarkId": { "const": "eilu-comparative-visual-v1" }, "comparisonThresholds": { "$ref": "#/$defs/thresholds" },
        "reviewEvidence": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/edgeEvidence" }] }
      }
    },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["requiredQueueCandidates", "passedQueueCandidates", "requiredFinalEdges", "passedFinalEdges", "missingCoverage"], "properties": { "requiredQueueCandidates": { "const": 175 }, "passedQueueCandidates": { "type": "integer", "minimum": 0, "maximum": 175 }, "requiredFinalEdges": { "const": 190 }, "passedFinalEdges": { "type": "integer", "minimum": 0, "maximum": 190 }, "missingCoverage": { "type": "integer", "minimum": 0, "maximum": 365 } } }
  },
  "allOf": [
    { "if": { "properties": { "state": { "const": "PENDING_G003_REVIEW" } } }, "then": { "properties": { "completionAllowed": { "const": false }, "coverage": { "properties": { "passedQueueCandidates": { "const": 0 }, "passedFinalEdges": { "const": 0 }, "missingCoverage": { "const": 365 } } } } } },
    { "if": { "properties": { "state": { "const": "PASS" } } }, "then": { "properties": { "completionAllowed": { "const": true }, "coverage": { "properties": { "passedQueueCandidates": { "const": 175 }, "passedFinalEdges": { "const": 190 }, "missingCoverage": { "const": 0 } } } } } }
  ]
}
