{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://punchgrow.local/contracts/g003-review-invalidity-v1.schema.json",
  "title": "Append-only signed G003 review invalidity v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "invalidityId", "invalidatedArtifactSha256", "invalidatedArtifactFileSha256", "reasonCode", "findingSha256", "priorInvaliditySha256", "issuedAt", "outputSha256", "publicSignature"],
  "properties": { "schemaVersion": { "const": "continuity-g003-review-invalidity-v1" }, "invalidityId": { "$ref": "#/$defs/sha" }, "invalidatedArtifactSha256": { "$ref": "#/$defs/sha" }, "invalidatedArtifactFileSha256": { "$ref": "#/$defs/sha" }, "reasonCode": { "type": "string", "minLength": 3 }, "findingSha256": { "$ref": "#/$defs/sha" }, "priorInvaliditySha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "issuedAt": { "type": "string", "format": "date-time" }, "outputSha256": { "$ref": "#/$defs/sha" }, "publicSignature": { "$ref": "#/$defs/signature" } },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityEpoch", "authorityFingerprint", "delegationOutputSha256", "purpose", "schemaSha256", "signatureBase64"], "properties": { "algorithm": { "const": "Ed25519" }, "authorityEpoch": { "const": "continuity-authority-epoch-v1" }, "authorityFingerprint": { "$ref": "#/$defs/sha" }, "delegationOutputSha256": { "$ref": "#/$defs/sha" }, "purpose": { "const": "continuity:g003-review-invalidity-v1" }, "schemaSha256": { "$ref": "#/$defs/sha" }, "signatureBase64": { "type": "string", "minLength": 88, "maxLength": 88 } } } }
}
