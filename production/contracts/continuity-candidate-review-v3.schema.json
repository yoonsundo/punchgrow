{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/continuity-candidate-review-v3.schema.json",
  "title": "PunchGrow cryptographically bound continuity candidate review v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolAuthoritySha256", "opaqueCandidateId", "generationRunId", "reviewKind", "packageManifestSha256", "materialBindingSha256", "inputAllowlistSha256", "promptSha256", "votes"],
  "properties": {
    "schemaVersion": { "const": "continuity-candidate-review-v3" },
    "protocolAuthoritySha256": { "const": "f585f5002c5f173a6a083e4a1d547d6b827d2277f140e94d1b8519d02b0124c7" },
    "opaqueCandidateId": { "type": "string", "pattern": "^candidate-[a-f0-9]{24}$" },
    "generationRunId": { "$ref": "#/$defs/generationRunId" },
    "reviewKind": { "enum": ["new-edge", "asset-reuse"] },
    "packageManifestSha256": { "$ref": "#/$defs/sha256" },
    "materialBindingSha256": { "$ref": "#/$defs/sha256" },
    "inputAllowlistSha256": { "$ref": "#/$defs/sha256" },
    "promptSha256": { "$ref": "#/$defs/sha256" },
    "votes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/vote" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "taxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["biologicalClass", "speciesFamily", "coreAnatomy", "locomotionPlan"],
      "properties": {
        "biologicalClass": { "type": "string", "minLength": 1, "not": { "pattern": "^unknown" } },
        "speciesFamily": { "type": "string", "minLength": 1, "not": { "pattern": "^unknown" } },
        "coreAnatomy": { "type": "string", "minLength": 1, "not": { "pattern": "^unknown" } },
        "locomotionPlan": { "type": "string", "minLength": 1, "not": { "pattern": "^unknown" } }
      }
    },
    "anchorEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorKey", "anchorId", "observation"],
      "properties": {
        "anchorKey": { "type": "string", "pattern": "^parent-[12]-[a-f0-9]{20}:.+$" },
        "anchorId": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "lockedAnchorEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorKey", "anchorId", "requiredDescription", "observation"],
      "properties": {
        "anchorKey": { "type": "string", "minLength": 10 },
        "anchorId": { "type": "string", "minLength": 1 },
        "requiredDescription": { "type": "string", "minLength": 3 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "requiredAnchorSet": {
      "type": "object", "additionalProperties": false,
      "required": ["opaqueInputId", "anchors"],
      "properties": {
        "opaqueInputId": { "type": "string", "minLength": 8 },
        "anchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lockedAnchorEvidence" } }
      }
    },
    "parentObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["opaqueParentId", "taxonomy", "sameCreatureGrownUp", "inheritedAnchorIds", "perAnchorEvidence"],
      "properties": {
        "opaqueParentId": { "type": "string", "pattern": "^parent-[12]-[a-f0-9]{20}$" },
        "taxonomy": { "$ref": "#/$defs/taxonomy" },
        "sameCreatureGrownUp": { "const": "yes" },
        "inheritedAnchorIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "perAnchorEvidence": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/anchorEvidence" } }
      }
    },
    "canonicalAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["matchesRequiredCanonicalTarget", "historicalParentComparisonRequired", "surfaceAssessments"],
      "properties": {
        "matchesRequiredCanonicalTarget": { "const": "yes" }, "historicalParentComparisonRequired": { "const": false },
        "surfaceAssessments": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/canonicalSurfaceAssessment" } }
      }
    },
    "canonicalSurfaceAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "matchesRequiredTaxonomy", "anchorAssessments", "satisfiedClarificationRequirements", "visibleAppendageCountsComply", "hiddenMergedOrDoubleReadableAmbiguity"],
      "properties": {
        "surface": { "enum": ["master", "runtime"] }, "matchesRequiredTaxonomy": { "const": "yes" },
        "anchorAssessments": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/canonicalAnchorAssessment" } },
        "satisfiedClarificationRequirements": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
        "visibleAppendageCountsComply": { "const": true }, "hiddenMergedOrDoubleReadableAmbiguity": { "const": false }
      }
    },
    "canonicalAnchorAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorId", "shapeRelativePlacementAndColorRolePreserved", "observation"],
      "properties": {
        "anchorId": { "type": "string", "minLength": 1 }, "shapeRelativePlacementAndColorRolePreserved": { "const": "yes" }, "observation": { "type": "string", "minLength": 1 }
      }
    },
    "eiluComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmarkId", "sameCreatureGrownUp", "stageObservations", "candidateContinuityScore", "retainedAnchorCount", "anchorRetentionRatio"],
      "properties": {
        "benchmarkId": { "const": "eilu-comparative-visual-v1" }, "sameCreatureGrownUp": { "const": "yes" },
        "stageObservations": { "type": "array", "minItems": 3, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["opaqueBenchmarkId", "masterSha256", "runtimeSha256", "continuityScore", "observation"],
          "properties": {
            "opaqueBenchmarkId": { "type": "string", "pattern": "^benchmark-[a-f0-9]{20}$" },
            "masterSha256": { "$ref": "#/$defs/sha256" }, "runtimeSha256": { "$ref": "#/$defs/sha256" },
            "continuityScore": { "type": "number", "minimum": 0.96, "maximum": 1 }, "observation": { "type": "string", "minLength": 1 }
          }
        } },
        "candidateContinuityScore": { "type": "number", "minimum": 0.96, "maximum": 1 },
        "retainedAnchorCount": { "type": "integer", "minimum": 3 }, "anchorRetentionRatio": { "type": "number", "minimum": 1 }
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["assessmentMode", "childTaxonomy", "parentObservations", "canonicalAssessment", "requiredAnchorEvidence", "eiluComparison"],
          "properties": {
            "assessmentMode": { "const": "same-creature-continuity" }, "childTaxonomy": { "$ref": "#/$defs/taxonomy" },
            "parentObservations": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/parentObservation" } },
            "canonicalAssessment": { "type": "null" },
            "requiredAnchorEvidence": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/requiredAnchorSet" } },
            "eiluComparison": { "$ref": "#/$defs/eiluComparison" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["assessmentMode", "childTaxonomy", "parentObservations", "canonicalAssessment", "requiredAnchorEvidence", "eiluComparison"],
          "properties": {
            "assessmentMode": { "const": "canonical-root-replacement" }, "childTaxonomy": { "$ref": "#/$defs/taxonomy" },
            "parentObservations": { "type": "array", "maxItems": 0 }, "canonicalAssessment": { "$ref": "#/$defs/canonicalAssessment" },
            "requiredAnchorEvidence": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/requiredAnchorSet" } },
            "eiluComparison": { "$ref": "#/$defs/eiluComparison" }
          }
        }
      ]
    },
    "vote": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "protocolAuthoritySha256", "reviewId", "reviewerInstanceId", "agentTaskId", "voterReviewRunId", "passNumber", "role", "fresh", "blinded", "opaqueCandidateId", "generationRunId", "packageManifestSha256", "materialBindingSha256", "inputAllowlistSha256", "promptSha256", "inputAssetSha256s", "assignmentManifestSha256", "reviewerRunAttestationSha256", "rawObservationSha256", "observation", "confidence", "outputSha256", "conductorHmacSha256"],
      "properties": {
        "schemaVersion": { "const": "continuity-candidate-primary-vote-v3" },
        "protocolAuthoritySha256": { "const": "f585f5002c5f173a6a083e4a1d547d6b827d2277f140e94d1b8519d02b0124c7" },
        "reviewId": { "type": "string", "minLength": 1 },
        "reviewerInstanceId": { "type": "string", "minLength": 1 }, "agentTaskId": { "type": "string", "minLength": 1 }, "voterReviewRunId": { "type": "string", "minLength": 1 },
        "passNumber": { "enum": [1, 2] }, "role": { "const": "primary" }, "fresh": { "const": true }, "blinded": { "const": true },
        "opaqueCandidateId": { "type": "string", "pattern": "^candidate-[a-f0-9]{24}$" }, "generationRunId": { "$ref": "#/$defs/generationRunId" },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" }, "materialBindingSha256": { "$ref": "#/$defs/sha256" }, "inputAllowlistSha256": { "$ref": "#/$defs/sha256" }, "promptSha256": { "$ref": "#/$defs/sha256" },
        "inputAssetSha256s": { "type": "array", "minItems": 10, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "assignmentManifestSha256": { "$ref": "#/$defs/sha256" }, "reviewerRunAttestationSha256": { "$ref": "#/$defs/sha256" }, "rawObservationSha256": { "$ref": "#/$defs/sha256" },
        "observation": { "$ref": "#/$defs/observation" }, "confidence": { "type": "number", "minimum": 0.96, "maximum": 1 },
        "outputSha256": { "$ref": "#/$defs/sha256" }, "conductorHmacSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
