{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://punchgrow.local/contracts/g003-quarantine-assignment-v1.schema.json",
  "title": "Zero-credit G003 quarantine assignment v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assignmentId", "role", "reviewerInstanceId", "agentTaskId", "reviewRunId", "passNumber", "materialKey", "materialSha256s", "archivedMaterialFileSha256s", "lockedContractSha256", "priorRejectionObservationSha256", "tombstoneOutputSha256", "tombstoneFileSha256", "obligationCredit", "pixelDisposition", "assignedAt", "outputSha256", "publicSignature"],
  "properties": { "schemaVersion": { "const": "continuity-g003-quarantine-assignment-v1" }, "assignmentId": { "type": "string", "minLength": 8 }, "role": { "const": "quarantine-invalidity" }, "reviewerInstanceId": { "type": "string", "minLength": 8 }, "agentTaskId": { "type": "string", "minLength": 8 }, "reviewRunId": { "type": "string", "minLength": 8 }, "passNumber": { "enum": [1, 2] }, "materialKey": { "$ref": "#/$defs/sha" }, "materialSha256s": { "$ref": "#/$defs/pair" }, "archivedMaterialFileSha256s": { "$ref": "#/$defs/pair" }, "lockedContractSha256": { "$ref": "#/$defs/sha" }, "priorRejectionObservationSha256": { "$ref": "#/$defs/sha" }, "tombstoneOutputSha256": { "$ref": "#/$defs/sha" }, "tombstoneFileSha256": { "$ref": "#/$defs/sha" }, "obligationCredit": { "const": 0 }, "pixelDisposition": { "const": "UNCHANGED" }, "assignedAt": { "type": "string", "format": "date-time" }, "outputSha256": { "$ref": "#/$defs/sha" }, "publicSignature": { "$ref": "#/$defs/signature" } },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pair": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } }, "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityEpoch", "authorityFingerprint", "delegationOutputSha256", "purpose", "schemaSha256", "signatureBase64"], "properties": { "algorithm": { "const": "Ed25519" }, "authorityEpoch": { "const": "continuity-authority-epoch-v1" }, "authorityFingerprint": { "$ref": "#/$defs/sha" }, "delegationOutputSha256": { "$ref": "#/$defs/sha" }, "purpose": { "const": "continuity:g003-quarantine-assignment-v1" }, "schemaSha256": { "$ref": "#/$defs/sha" }, "signatureBase64": { "type": "string", "minLength": 88, "maxLength": 88 } } } }
}
