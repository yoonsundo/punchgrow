{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://punchgrow.local/contracts/continuity-pack-lock-v1.schema.json",
  "title": "PunchGrow immutable continuity pack lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "manifest", "reviewCoverage", "finalization", "sourceTreeSha256", "entryCount", "outputSha256", "publicSignature"],
  "properties": {
    "schemaVersion": { "const": "continuity-pack-lock-v1" }, "packId": { "const": "biological-continuity-v3" },
    "manifest": { "$ref": "#/$defs/file" }, "reviewCoverage": { "$ref": "#/$defs/file" },
    "finalization": {
      "type": "object", "additionalProperties": false,
      "required": ["statePath", "stateSha256", "acceptedTipSetSha256", "acceptedTipCount", "terminalStatePath"],
      "properties": {
        "statePath": { "const": "production/reports/biological-continuity-v3/g003-evidence-v1/finalization/finalizing.json" },
        "stateSha256": { "$ref": "#/$defs/sha256" },
        "acceptedTipSetSha256": { "$ref": "#/$defs/sha256" },
        "acceptedTipCount": { "const": 365 },
        "terminalStatePath": { "const": "production/reports/biological-continuity-v3/g003-evidence-v1/finalization/terminal.json" }
      }
    },
    "sourceTreeSha256": { "$ref": "#/$defs/sha256" }, "entryCount": { "const": 240 }, "outputSha256": { "$ref": "#/$defs/sha256" },
    "publicSignature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "authorityFingerprint", "signatureBase64"],
      "properties": { "algorithm": { "const": "Ed25519" }, "authorityFingerprint": { "$ref": "#/$defs/sha256" }, "signatureBase64": { "type": "string", "minLength": 80 } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
